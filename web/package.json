{
  "name": "parkread-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "dev:lan": "vite --host",
    "test": "vitest run --exclude \"measure/**\" --exclude \"build/**\"",
    "test:watch": "vitest",
    "measure": "vitest run --dir measure --reporter=verbose",
    "test:build": "vitest run --dir build --reporter=verbose",
    "emit": "node tools/emit.ts --write",
    "emit:check": "node tools/emit.ts",
    "icons": "node tools/icons.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
