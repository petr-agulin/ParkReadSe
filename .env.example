# ParkRead Sweden — settings for one development command.
#
# The app does NOT use this file: people enter their own key in the app's Settings, and
# it stays in their browser. Only `npm run ask` reads it — the command that asks the AI
# model about the test photographs again. To use it, copy this file to `.env` and fill
# in your own key. Never commit `.env`.

# Your API key from your AI provider. For Google, see:
# https://aistudio.google.com/docs/api-key
VISION_API_KEY=

# The provider's API address. These are not web pages to open in a browser: they are
# addresses the app sends its requests to. Any provider that speaks the OpenAI-compatible
# format (POST /chat/completions) works; changing provider means changing this line and
# the model below, not the code.
#
#   Google:     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral:    https://api.mistral.ai/v1
#   OpenRouter: https://openrouter.ai/api/v1

VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# The model. It must accept images; a text-only model will not work. The same model is
# used for both calls: the quick check and the reading of the sign.
VISION_MODEL=gemini-3.5-flash-lite
