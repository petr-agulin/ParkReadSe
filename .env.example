# ParkRead — переменные окружения.
#
# Значения ниже рабочие: всё, кроме ключа, можно оставить как есть.
# Ключ вписывается свой — чужие ключи в проекте не хранятся и не передаются.


# --- Режим работы ------------------------------------------------------------

# true  — приложение работает на закешированных ответах модели из папки фикстур.
#         Ключ не нужен вовсе: сценарий проходится целиком, включая отказы.
# false — каждый снимок уходит в vision-API. Нужен ключ ниже.
DEMO_MODE=true

# Папка с демо-набором: ответы модели по снимкам тестового набора.
# Каждый живой ответ сохраняется сюда сам, поэтому набор растёт по ходу работы.
# Файлы помечены origin: model (настоящий ответ модели) либо origin: hand_marked
# (эталон-затравка). Второе в замер точности не входит: мерить модель по эталону,
# написанному не моделью, значит всегда получать 100%.
DEMO_FIXTURES_PATH=demo/


# --- Vision-API --------------------------------------------------------------

# Ключ доступа. Нужен только при DEMO_MODE=false.
# Google AI Studio выдаёт его бесплатно по аккаунту Google, без карты:
# https://aistudio.google.com/apikey
VISION_API_KEY=

# Адрес API провайдера. Диалект — OpenAI-совместимый (POST /chat/completions),
# и его понимают все три провайдера ниже. Поэтому смена провайдера — правка
# этой строки и следующей, а не правка кода.
#
#   Google:     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral:    https://api.mistral.ai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#
# Значения по умолчанию у кода нет намеренно: адрес провайдера — настройка
# развёртывания, и держать её ещё и в исходниках значит иметь провайдера
# в двух местах сразу.
VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Модель для разбора знака. Обязательно с поддержкой изображений: текстовая
# модель для этой задачи не годится.
# Эта проверена на собственных снимках — см. testset/PROBE_LOG.md.
VISION_MODEL=gemini-3.5-flash-lite

# Модель для стадии отсева: она отвечает на один вопрос — парковочный ли это знак.
# Смысл отсева в том, чтобы модель извлечения была дороже модели отсева. На бесплатном
# тарифе разницы в цене нет, поэтому здесь та же модель — и замер этапа 2 показал,
# что при одинаковой цене отсев не окупается: точка безубыточности 50% мусора.
# Отсев остаётся ради продукта, а не ради денег: ответ «на снимке апельсин» честнее,
# чем разбор, собранный из пустоты.
TRIAGE_MODEL=gemini-3.5-flash-lite

# Что делать со снимком, который отсев признал не парковочным знаком.
# true  — остановиться и сказать пользователю, что знака на снимке нет.
# false — метка только записывается, снимок всё равно уходит в извлечение.
#         Нужно, чтобы измерить долю ложных отсевов, не теряя разборы.
TRIAGE_ENFORCE=true

# Ограничение частоты запросов, запросов в минуту. 0 — без ограничения.
# Упирается прогон набора именно в поминутный лимит, а не в суточный: на снимок
# уходит два вызова, и пятнадцать запросов кончаются на восьмой фотографии,
# когда суточных израсходована пятая часть. У бесплатного тарифа Google
# Gemini 3.5 Flash Lite это 15 запросов в минуту.
VISION_MAX_RPM=15


# --- Источники трактовки -----------------------------------------------------
#
# Это не база законов, а граница компетенции продукта: чего нет в справочнике,
# то сервис показывает дословно и не интерпретирует.

# Схемы ответов модели — контракт между моделью и детерминированным кодом.
SCHEMA_PATH=schema/

# Справочник знаков и табличек. Он же белый список: только эти коды попадают
# в вычисления, всё остальное показывается дословно.
REFERENCE_PATH=reference/signs/

# Заметки об общих правилах, которых на знаке нет. Показываются справкой
# с явной пометкой; в вычисления движка не входят никогда.
GENERAL_RULES_PATH=reference/general_rules/

# Календаря здесь больше нет: классы дня считаются кодом (parkread/calendar_se.py),
# праздники выводятся из закона, окно продукта — 2026-2030. Настраивать нечего.


# --- Хранилище и логи --------------------------------------------------------

# История разборов. Пишет её код приложения; модель её не читает и не пишет.
# Фотографии пользователя сюда не попадают — они не сохраняются на диск вообще.
DB_PATH=data/parkread.sqlite3

# DEBUG | INFO | WARNING | ERROR
# Ключи, содержимое .env и персональные данные в логи не пишутся никогда.
LOG_LEVEL=INFO


# Порога уверенности здесь пока нет намеренно. Он появится, когда его будет чем
# обосновать: значение калибруется замером на тестовом наборе (этап 5 в PLAN.md).
# Переменная, которую можно покрутить без всякого эффекта, хуже её отсутствия.
