# ParkRead — environment variables.
#
# Needed by ONE developer command: `npm run ask`, which asks the model about the set's
# photographs again. The application itself does not read them: a person's key lives
# in their own browser, and they enter it on the key screen.
#
# Put in your own key — nobody else's keys are stored in the project or passed on.

# The access key. Google AI Studio issues one free with a Google account, no card:
# https://aistudio.google.com/apikey
VISION_API_KEY=

# The provider's API address. The dialect is OpenAI-compatible (POST /chat/completions),
# and all three providers below understand it. So changing provider means editing this
# line and the next, not the code.
#
#   Google:     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral:    https://api.mistral.ai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#
# The code has no default on purpose: an empty field is a refusal, not a guess.
VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# The model. It must support images: a text-only model will not do for this task.
# One model for both stages — the triage and the extraction (decision 134).
VISION_MODEL=gemini-3.5-flash-lite
