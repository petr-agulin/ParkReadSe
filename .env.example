# ParkRead — переменные окружения.
#
# Нужны ОДНОЙ команде разработчика: `npm run ask` — переспросить модель по снимкам
# набора. Само приложение их не читает: ключ человека живёт у него в браузере,
# и вводит он его на экране ключа.
#
# Ключ вписывается свой — чужие ключи в проекте не хранятся и не передаются.

# Ключ доступа. Google AI Studio выдаёт его бесплатно по аккаунту Google, без карты:
# https://aistudio.google.com/apikey
VISION_API_KEY=

# Адрес API провайдера. Диалект — OpenAI-совместимый (POST /chat/completions),
# и его понимают все три провайдера ниже. Поэтому смена провайдера — правка
# этой строки и следующей, а не правка кода.
#
#   Google:     https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral:    https://api.mistral.ai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#
# Значения по умолчанию у кода нет намеренно: пустое поле — отказ, а не догадка.
VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Модель. Обязательно с поддержкой изображений: текстовая для этой задачи не годится.
# Одна на обе стадии — и на отсев, и на извлечение (решение 134).
VISION_MODEL=gemini-3.5-flash-lite
